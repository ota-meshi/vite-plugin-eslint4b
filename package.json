{
  "name": "vite-plugin-eslint4b",
  "version": "0.9.0",
  "description": "Vite plugin for running ESLint on browser",
  "main": "lib/vite-plugin-eslint4b.mjs",
  "module": "lib/vite-plugin-eslint4b.mjs",
  "type": "module",
  "files": [
    "lib",
    "shim"
  ],
  "exports": {
    ".": {
      "import": "./lib/vite-plugin-eslint4b.mjs",
      "require": "./lib/vite-plugin-eslint4b.cjs",
      "default": "./lib/vite-plugin-eslint4b.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "npx -y rimraf .nyc_output lib coverage",
    "cover": "nyc --reporter=lcov npm run test",
    "debug": "node -r esbuild-register ./node_modules/mocha/bin/mocha.js \"tests/src/**/*.ts\" --reporter dot --timeout 60000",
    "eslint-fix": "npm run lint -- --fix",
    "lint": "eslint . && tsc --noEmit",
    "mocha": "node -r esbuild-register ./node_modules/mocha/bin/mocha.js",
    "prerelease": "npm run clean && npm run build",
    "preversion": "npm run lint && npm run test",
    "release": "changeset publish",
    "test": "node -r esbuild-register ./node_modules/mocha/bin/mocha.js \"tests/src/**/*.ts\" --reporter dot --timeout 60000",
    "ts": "node -r esbuild-register"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ota-meshi/vite-plugin-eslint4b.git"
  },
  "keywords": [
    "eslint",
    "vite",
    "browser"
  ],
  "author": "Yosuke Ota (https://github.com/ota-meshi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ota-meshi/vite-plugin-eslint4b/issues"
  },
  "homepage": "https://github.com/ota-meshi/vite-plugin-eslint4b#readme",
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.3.0",
    "@ota-meshi/eslint-plugin": "^0.20.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild-register": "^3.4.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^64.0.0",
    "eslint-plugin-json-schema-validator": "^6.0.0",
    "eslint-plugin-jsonc": "^3.0.0",
    "eslint-plugin-n": "^18.0.0",
    "eslint-plugin-node-dependencies": "^2.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-yml": "^3.0.0",
    "jsonc-eslint-parser": "^3.0.0",
    "mocha": "^11.0.0",
    "prettier": "^3.2.5",
    "tsdown": "^0.21.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "assert": "^2.0.0",
    "magic-string": "^1.0.0",
    "rolldown": "^1.0.0"
  },
  "overrides": {
    "rolldown-plugin-dts": {
      "@babel/types": {
        "@babel/helper-string-parser": "8.0.0"
      }
    }
  }
}
